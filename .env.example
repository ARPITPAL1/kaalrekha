# ==============================================================================
# KAALREKHA HISTORICAL ARCHIVE — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# GOOGLE OAUTH 2.0 / OPENID CONNECT CREDENTIALS
# Obtain these from Google Cloud Console: https://console.cloud.google.com/
# ------------------------------------------------------------------------------
# Client ID for frontend Google Identity Services SDK
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# Client ID & Secret for backend token validation
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# ------------------------------------------------------------------------------
# EMAIL SMTP CONFIGURATION (Optional - for direct email dispatch)
# ------------------------------------------------------------------------------
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="KAALREKHA Archive <no-reply@kaalrekha.org>"
